---
import MainHead from '../layouts/MainHead.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';

// component imports
interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "My Astro Blog", 
	description = "My musings on Astro" 
} = Astro.props as Props;

// style import
import '../styles/global.css';

---

<!doctype html>
<html lang="en">
	<MainHead {title} {description} />
	<body>
		<Nav />
		<slot />
	</body>
	<Footer />

</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
